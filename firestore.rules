rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Statisk kort-data, prisøjeblikksbilder og league-cache er offentlig
    // lesbare (siden viser kun priskalkulasjoner, ingen sensitiv info).
    // All skriving skjer via Admin SDK (seedCards/refreshPrices-scriptene),
    // som ikke er underlagt disse reglene - klienten skal derfor aldri
    // kunne skrive.
    match /divination_cards/{cardId} {
      allow read: if true;
      allow write: if false;
    }

    match /prices/{priceId} {
      allow read: if true;
      allow write: if false;
    }

    match /leagues/{leagueId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
